//         text = elem.text().trim(),
//         first = text.slice(0, 1);

//     if (!elem.length)
//         return;

//     elem[0].nodeValue = text.slice(first.length);
//     elem.before('<span class="dropcap">' + first + '</span>');
//  });

if ($('#content-index .article-item-image').length > 0) {
   $('#content-index .article-item-image> a:first-child').each(function(i, obj) {
     console.log($(obj).children()[0].src);
     var image_url = $(obj).children()[0].src; 
     var decodedUrl = decodeURIComponent(image_url); 
     var encodedUrl = encodeURI(decodedUrl);
     $(obj).children()[0].src = encodedUrl
   });
 }
  

})(jQuery)
